# The Compact (MVP) API service (blueprint 6.2, 14): JSON API v1 for the web
# UI, the local Unix-socket API for vakr tui and the CLI, and later the
# replication endpoints. It reads telemetry (the collector is its only
# writer) and writes metadata: sessions, audit records, identity decisions.
#
# It listens on loopback TCP (127.0.0.1:8080, plain HTTP) for a reverse proxy
# on the same host that terminates TLS (SEC-013), and on /run/vakr/api.sock,
# where the connecting account decides the role (Appendix E.12).
#
# Shipped disabled, like every vakr unit (PKG-003). Enable it with
#   sudo systemctl enable --now vakr-api.service vakr.target
# See docs/operations/api.md and docs/operations/web-access.md.
[Unit]
Description=vakr API (JSON API v1 and the local socket)
Documentation=https://robert-patrick-texas.github.io/vakr/docs/operations/api.html
After=network.target
PartOf=vakr.target
# At most five failed starts in ten minutes, then systemd stops trying (SVC-009).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
# READY=1 is sent once the startup checks passed and both listeners are open.
Type=notify
NotifyAccess=main
ExecStart=/opt/vakr/venv/bin/vakr api serve
User=vakr
Group=vakr
SyslogIdentifier=vakr-api
Restart=on-failure
RestartSec=10s
# Exit 78 is a failed startup check (configuration, schema, key file, port in
# use): an operator must act, so systemd does not restart it.
RestartPreventExitStatus=78
TimeoutStartSec=60s
# Requests in progress get 10 s to finish at stop (Appendix E.30).
TimeoutStopSec=30s
KillSignal=SIGTERM
# Resource limits for the Compact workload (SVC-009, E.30).
MemoryMax=1G
TasksMax=256
LimitNOFILE=4096

# Hardening (15.3): no capability at all; the whole system is read-only
# except the state directory (metadata.db, auth.key) and /run/vakr (the socket).
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/vakr /run/vakr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=vakr.target
