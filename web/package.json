{
	"name": "vakr-web",
	"version": "0.0.0",
	"private": true,
	"description": "vakr web UI: a static SvelteKit client of API v1 (ADR-035). The release number comes from GET /api/v1/version, never from here (VER-001).",
	"license": "Apache-2.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.22.0 <25",
		"npm": ">=11.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/csp-manifest.js build",
		"preview": "vite preview",
		"gen:api": "openapi-typescript ../docs/api/openapi.json --output src/lib/api/schema.d.ts",
		"check:api": "node scripts/check-api-types.js",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"e2e": "playwright test",
		"licenses": "node scripts/check-licenses.js"
	},
	"dependencies": {
		"@sveltejs/kit": "3.1.0",
		"@tanstack/svelte-query": "6.3.5",
		"@tanstack/svelte-table": "9.3.1",
		"echarts": "6.1.0",
		"openapi-fetch": "0.17.0",
		"svelte": "5.57.2",
		"uplot": "1.6.32"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.5",
		"eslint": "10.13.0",
		"eslint-plugin-jsdoc": "65.4.0",
		"eslint-plugin-svelte": "3.23.1",
		"eslint-plugin-tsdoc": "0.5.4",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte-check": "4.7.7",
		"svelte-eslint-parser": "1.9.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
